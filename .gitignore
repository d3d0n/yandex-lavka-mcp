# Block sensitive files even inside allowed directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.har
**/*.pcap
**/*.pcapng
**/*session*
**/*cookie*
**/*capture*
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/*.py[cod]
!/lavka_rejection_capture.py
!/tests/test_rejection_capture.py
