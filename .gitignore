!/tests/test_private_response.py
!/tests/test_qr_auth.py
!/tests/test_qr_image.py
!/tests/test_qr_import_order.py
!/tests/test_qr_mcp.py
!/tests/test_qr_persistence.py
!/tests/test_qr_runtime.py
!/tests/test_qr_server_integration.py
!/tests/test_rejection_capture.py
